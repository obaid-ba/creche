msgstr[2] "سنتان"
msgstr[3] "%(count)d سنوات"
msgstr[4] "%(count)d سنة"
msgstr[5] "%(count)d سنة"

#, python-format
msgid "%(years)s et %(months)s"
msgstr "%(years)s و%(months)s"

msgid "Les données envoyées sont invalides."
msgstr "البيانات المرسلة غير صالحة."

msgid "Authentification requise ou session expirée."
msgstr "يلزم تسجيل الدخول أو انتهت صلاحية الجلسة."

msgid "Vous n'avez pas l'autorisation d'effectuer cette action."
msgstr "لا تملك صلاحية القيام بهذا الإجراء."

msgid "La ressource demandée est introuvable."
msgstr "المورد المطلوب غير موجود."

msgid "Méthode non autorisée."
msgstr "طريقة غير مسموح بها."

msgid "Cette opération entre en conflit avec l'état actuel."
msgstr "هذه العملية تتعارض مع الحالة الراهنة."

msgid "Le fichier envoyé est trop volumineux."
msgstr "الملف المرسل كبير جداً."

msgid "Ce type de fichier n'est pas accepté."
msgstr "هذا النوع من الملفات غير مقبول."

msgid "Trop de tentatives. Veuillez réessayer plus tard."
msgstr "محاولات كثيرة. يرجى إعادة المحاولة لاحقاً."

msgid "Une erreur interne est survenue. Veuillez réessayer."
msgstr "حدث خطأ داخلي. يرجى إعادة المحاولة."

msgid "Une erreur est survenue."
msgstr "حدث خطأ."

#, python-format
msgid "Le fichier dépasse la taille maximale de %(max)s Mo."
msgstr "حجم الملف يتجاوز الحد الأقصى %(max)s ميغابايت."

msgid "Ce fichier n'est pas une image valide."
msgstr "هذا الملف ليس صورة صالحة."

msgid "Format non accepté. Utilisez JPEG, PNG ou WebP."
msgstr "صيغة غير مقبولة. استعمل JPEG أو PNG أو WebP."

msgid "Réservé au personnel de la crèche."
msgstr "مخصّص لموظفي الحضانة."
