# ─── Crèche Mamati — environment template ───────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real `.env`.

# ── Django ──────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ── Database ────────────────────────────────────────────────────────────
# Host `db` is the Docker Compose service name.
POSTGRES_DB=creche_mamati
POSTGRES_USER=creche
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://creche:change-me-in-production@db:5432/creche_mamati

# ── Auth / tokens ───────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
REFRESH_COOKIE_NAME=creche_refresh
# MUST be True in production
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Strict
REFRESH_COOKIE_DOMAIN=

# Separate key used to HMAC child access codes (docs/authentication.md §4.3).
# Must differ from DJANGO_SECRET_KEY, and rotating it invalidates all
# unclaimed codes.
ACCESS_CODE_HMAC_KEY=change-me-generate-a-separate-random-string
ACCESS_CODE_TTL_DAYS=30
ACCESS_CODE_PREFIX=MAM

# ── CORS / CSRF ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Media storage ───────────────────────────────────────────────────────
# local | s3
MEDIA_STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# S3-compatible (only when MEDIA_STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# ── Throttling (requests/hour) ──────────────────────────────────────────
THROTTLE_LOGIN=10
THROTTLE_CLAIM=5
THROTTLE_CONTACT=5
THROTTLE_USER=1000

# ── Nursery settings ────────────────────────────────────────────────────
NURSERY_NAME=Crèche Mamati
# defines the "local day" for the timeline
NURSERY_TIMEZONE=Africa/Tunis
NURSERY_EMAIL=contact@creche-mamati.com
NURSERY_PHONE=
NURSERY_ADDRESS=

# ── Email ───────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@creche-mamati.com

# ── Frontend (Vite — only VITE_* reaches the browser) ────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=Crèche Mamati
